# CSS colour strings as the TS writes them: '#rrggbb' or 'rgba(r, g, b, a)'.
func _css_color(text: String) -> Color:
	if text.begins_with("#"):
		return Color(text)
	var inner: String = text.trim_prefix("rgba(").trim_suffix(")")
	var parts: PackedStringArray = inner.split(",")
	assert_eq(parts.size(), 4, "rgba() has four components: %s" % text)
	return Color(
		parts[0].strip_edges().to_float() / 255.0,
		parts[1].strip_edges().to_float() / 255.0,
		parts[2].strip_edges().to_float() / 255.0,
		parts[3].strip_edges().to_float()
	)


func _assert_color(actual: Color, css: String, what: String) -> void:
	var want: Color = _css_color(css)
	assert_almost_eq(actual.r, want.r, 0.002, "%s r" % what)
	assert_almost_eq(actual.g, want.g, 0.002, "%s g" % what)
	assert_almost_eq(actual.b, want.b, 0.002, "%s b" % what)
	assert_almost_eq(actual.a, want.a, 0.002, "%s a" % what)


func _assert_dict_numbers_equal(actual: Dictionary, expected: Dictionary, what: String) -> void:
	assert_eq(actual.keys().size(), expected.keys().size(), "%s key count" % what)
	# PORT-NOTE: expected's values are Variant, same as the parsed JSON
	# (CONVENTIONS §4); each branch binds a typed local after its is-check
	# (tilt_input.gd:387 precedent) because the check does not narrow call arguments.
	for key: String in expected.keys():
		assert_true(actual.has(key), "%s is missing %s" % [what, key])
		var want: Variant = expected[key]
		if want is bool:
			var want_bool: bool = want
			assert_eq(
				SaveStore.read_bool(actual, key, not want_bool), want_bool, "%s.%s" % [what, key]
			)
		elif want is float:
			var want_float: float = want
			assert_almost_eq(
				SaveStore.read_float(actual, key, -1.0), want_float, 0.0001, "%s.%s" % [what, key]
			)
		elif want is Dictionary:
			var want_dict: Dictionary = want
			assert_true(actual[key] is Dictionary, "%s.%s is an object" % [what, key])
			var sub: Dictionary = actual[key]
			_assert_dict_numbers_equal(sub, want_dict, "%s.%s" % [what, key])
		elif want is String:
			var want_string: String = want
			assert_eq(SaveStore.read_string(actual, key, ""), want_string, "%s.%s" % [what, key])
		elif want is Array:
			var want_array: Array = want
			assert_eq(SaveStore.read_string_array(actual, key), want_array, "%s.%s" % [what, key])
		else:
			fail_test("%s.%s has an unexpected fixture type" % [what, key])


func test_default_data_matches_the_typescript() -> void:
	# PORT-NOTE: same Variant-narrowing gap as _assert_dict_numbers_equal
	# above — bind a typed local before passing it as a call argument.
	var ts_default: Dictionary = _fixture["default_data"]
	var expected: Dictionary = ts_default.duplicate(true)
	# DIVERGENCE(ECON R3): the start balance is 500 (TS 7331); the rest is the TS's.
	expected["points"] = float(ProgressionManager.STARTING_POINTS)  # JSON numbers are floats
	expected["lifetimePoints"] = float(ProgressionManager.STARTING_POINTS)
	# DIVERGENCE(KEY R1): the added keystones, all unbought in a fresh save.
	var ts_perks: Dictionary = expected["perks"]
	var added: Dictionary = {
		"blackhole": ["eventHorizon", "darkHarvest"],
		"nuke": ["chainReaction", "stunWave"],
		"shield": ["overchargePulse", "coinVacuum"],
		"missiles": ["clusterSplit", "hyperThrusters", "secondSalvo"],
		"laser": ["heavyBeam", "rapidSweep"],
		"lightning": ["plasmaArc", "superconductor", "forkedLightning"],
		"freeze": ["cryoNova", "iceArmor"],
	}
	for weapon: String in added:
		var record: Dictionary = ts_perks[weapon]
		for key: String in added[weapon]:
			record[key] = false
	_assert_dict_numbers_equal(_pm.data.to_dict(), expected, "default_data")


func test_ship_catalog_matches_the_typescript() -> void:
	var expected: Array = _fixture["ship_catalog"]
	assert_eq(_pm.ship_catalog.size(), expected.size(), "ship count")
	assert_true(
		is_same(_pm.cursor_catalog, _pm.ship_catalog), "cursorCatalog is shipCatalog (:278)"
	)
	for i: int in range(expected.size()):
		var want: Dictionary = expected[i]
		var ship: ProgressionManager.ShipSkinConfig = _pm.ship_catalog[i]
		var tag: String = "ship[%d]" % i
		assert_eq(ship.id, SaveStore.read_string(want, "id", ""), tag)
		assert_eq(ship.name, SaveStore.read_string(want, "name", ""), tag)
		assert_eq(ship.trait_text, SaveStore.read_string(want, "trait", ""), tag)
		assert_eq(ship.price, SaveStore.read_int(want, "price", -1), tag)
		assert_eq(ship.description, SaveStore.read_string(want, "description", ""), tag)
		assert_eq(ship.hitbox, SaveStore.read_string(want, "hitbox", ""), tag)
		assert_eq(ship.turn, SaveStore.read_string(want, "turn", ""), tag)
		assert_almost_eq(
			ship.hitbox_scale, SaveStore.read_float(want, "hitboxScale", -1.0), 0.0001, tag
		)
		assert_almost_eq(ship.turn_rate, SaveStore.read_float(want, "turnRate", -1.0), 0.0001, tag)
		assert_eq(
			ship.starting_weapon,
			WEAPON_NAMES[SaveStore.read_string(want, "startingWeapon", "")],
			tag
		)
		assert_eq(ship.bonus_lives, SaveStore.read_int(want, "bonusLives", 0), tag)
		_assert_color(ship.tint, SaveStore.read_string(want, "tint", ""), tag + " tint")
		assert_eq(ship.svg_path, SaveStore.read_string(want, "svgPath", ""), tag)
		_assert_color(ship.hull_color, SaveStore.read_string(want, "hullColor", ""), tag + " hull")
		_assert_color(
			ship.primary_color, SaveStore.read_string(want, "primaryColor", ""), tag + " primary"
		)
		_assert_color(
			ship.accent_color, SaveStore.read_string(want, "accentColor", ""), tag + " accent"
		)
		_assert_color(
			ship.thruster_color, SaveStore.read_string(want, "thrusterColor", ""), tag + " thruster"
		)
		_assert_color(
			ship.trail_color, SaveStore.read_string(want, "trailColor", ""), tag + " trail"
		)
		_assert_color(
			ship.tether_color, SaveStore.read_string(want, "tetherColor", ""), tag + " tether"
		)
		assert_eq(ship.shape, SHAPE_NAMES[SaveStore.read_string(want, "shape", "")], tag)


