## test_tuning_parity.gd
## PORTS: nothing — new file, spec §6.3 Tier 2 constant-parity harness
extends GutTest
## Asserts core/tuning.gd equals the TypeScript table byte for byte, via the
## fixture generated by tools/parity/dump_constants.mjs.

const FIXTURE_PATH: String = "res://tests/fixtures/weapon_tuning.json"

# PORT-NOTE: mapping local to the spec, not tuning.gd — Tuning has no
# unit_to_string() because WeaponTuning.ts has none either (Law 4). Only the
# fixture's spelling needs to be compared to Tuning.TuningUnit here.
const UNIT_NAMES: Dictionary[Tuning.TuningUnit, String] = {
	Tuning.TuningUnit.RANGE: "range",
	Tuning.TuningUnit.SECONDS: "seconds",
	Tuning.TuningUnit.PERCENT: "percent",
	Tuning.TuningUnit.COUNT: "count",
}

var _fixture: Dictionary = {}


func before_all() -> void:
	var file: FileAccess = FileAccess.open(FIXTURE_PATH, FileAccess.READ)
	assert_not_null(file, "missing fixture — run: node tools/parity/dump_constants.mjs")
	var raw: String = file.get_as_text()
	file.close()
	# PORT-NOTE: Variant is unavoidable for unvalidated JSON; CONVENTIONS §4
	# permits it here and the next line narrows it immediately.
	var parsed: Variant = JSON.parse_string(raw)
	assert_true(parsed is Dictionary, "fixture must be a JSON object")
	_fixture = parsed


func test_every_weapon_and_track_matches() -> void:
	var expected: Dictionary = _fixture["weapon_tuning"]
	assert_eq(Tuning.weapon_tuning.size(), expected.size(), "same number of weapons")
	for weapon: String in expected.keys():
		assert_true(Tuning.weapon_tuning.has(weapon), "tuning.gd is missing %s" % weapon)
		var expected_tracks: Dictionary = expected[weapon]
		var actual_tracks: Dictionary = Tuning.weapon_tuning[weapon]
		assert_eq(actual_tracks.size(), expected_tracks.size(), "%s track count" % weapon)
		for track: String in expected_tracks.keys():
			assert_true(actual_tracks.has(track), "%s.%s is missing" % [weapon, track])
			var want: Dictionary = expected_tracks[track]
			var got: Tuning.TuningEntry = actual_tracks[track]
			# PORT-NOTE: want's values are Variant, same as the parsed JSON above
			# (CONVENTIONS §4) — float()/String() genuinely require the cast.
			@warning_ignore("unsafe_call_argument")
			var want_base: float = float(want["base"])
			@warning_ignore("unsafe_call_argument")
			var want_per_rank: float = float(want["perRank"])
			@warning_ignore("unsafe_call_argument")
			var want_max: float = float(want["max"])
			@warning_ignore("unsafe_call_argument")
			var want_unit: String = String(want["unit"])
			assert_almost_eq(got.base, want_base, 0.0001, "%s.%s base" % [weapon, track])
			assert_almost_eq(got.per_rank, want_per_rank, 0.0001, "%s.%s perRank" % [weapon, track])
			assert_almost_eq(got.max, want_max, 0.0001, "%s.%s max" % [weapon, track])
			var got_unit_name: String = UNIT_NAMES.get(got.unit, "")
			assert_eq(got_unit_name, want_unit, "%s.%s unit" % [weapon, track])


func test_get_tuned_value_matches_every_sample() -> void:
	var samples: Array = _fixture["tuned_value_samples"]
	assert_gt(samples.size(), 0, "fixture carries samples")
	for entry: Variant in samples:
		var sample: Dictionary = entry
		# PORT-NOTE: sample's values are Variant, same as the parsed JSON above
		# (CONVENTIONS §4) — String()/int()/float() genuinely require the cast.
		@warning_ignore("unsafe_call_argument")
		var sample_weapon: String = String(sample["weapon"])
		@warning_ignore("unsafe_call_argument")
		var sample_track: String = String(sample["track"])
		@warning_ignore("unsafe_call_argument")
		var sample_rank: int = int(sample["rank"])
		@warning_ignore("unsafe_call_argument")
		var sample_value: float = float(sample["value"])
		var got: float = Tuning.get_tuned_value(sample_weapon, sample_track, sample_rank)
		assert_almost_eq(
			got,
			sample_value,
			0.0001,
			"get_tuned_value(%s, %s, %d)" % [sample_weapon, sample_track, sample_rank]
		)


func test_scalar_constants_match() -> void:
	# PORT-NOTE: _fixture's values are Variant, same as the parsed JSON above
	# (CONVENTIONS §4) — float()/int() genuinely require the cast.
	@warning_ignore("unsafe_call_argument")
	var shockwave: float = float(_fixture["supernova_shockwave"])
	assert_almost_eq(Tuning.SUPERNOVA_SHOCKWAVE, shockwave, 0.0001, "shockwave")
	var costs: Dictionary = _fixture["keystone_costs"]
	# DIVERGENCE(KEY R1): nine keystones added past the TS's 13; every TS price is kept.
	assert_eq(Tuning.KEYSTONE_COSTS.size(), costs.size() + 9, "keystone count")
	for key: String in costs.keys():
		@warning_ignore("unsafe_call_argument")
		var cost: int = int(costs[key])
		var want_cost: int = Tuning.KEYSTONE_COSTS.get(key, -1)
		assert_eq(want_cost, cost, "keystone %s" % key)
