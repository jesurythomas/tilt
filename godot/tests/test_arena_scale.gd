## test_arena_scale.gd
## PORTS: nothing — new file, spec §6.3 Tier 2 parity for the arenaScale formula
extends GutTest
## Asserts GameRoot.arena_scale() equals TiltGame.resizeCanvas() for every
## fixture case generated by tools/parity/dump_constants.mjs.

const FIXTURE_PATH: String = "res://tests/fixtures/arena_scale.json"
const TS_CEILING: float = 1.15  # PORT: web/src/tilt-to-live/TiltGame.ts:2431


func test_arena_scale_matches_the_typescript_for_every_case() -> void:
	var file: FileAccess = FileAccess.open(FIXTURE_PATH, FileAccess.READ)
	assert_not_null(file, "missing fixture — run: node tools/parity/dump_constants.mjs")
	var raw: String = file.get_as_text()
	file.close()
	# PORT-NOTE: Variant is unavoidable for unvalidated JSON; CONVENTIONS §4
	# permits it here and the next line narrows it immediately.
	var parsed: Variant = JSON.parse_string(raw)
	assert_true(parsed is Dictionary, "fixture must be a JSON object")
	var fixture: Dictionary = parsed
	var cases: Array = fixture["cases"]
	assert_gt(cases.size(), 0, "fixture carries cases")

	for entry: Variant in cases:
		var c: Dictionary = entry
		# PORT-NOTE: c's values are Variant, same as the parsed JSON above
		# (CONVENTIONS §4) — float() genuinely requires the cast.
		@warning_ignore("unsafe_call_argument")
		var w: float = float(c["width"])
		@warning_ignore("unsafe_call_argument")
		var h: float = float(c["height"])
		@warning_ignore("unsafe_call_argument")
		var expected_scale: float = float(c["scale"])
		var got: float = GameRoot.arena_scale(w, h)

		# DIVERGENCE(M2.5 §7.3): the TypeScript clamps at 1.15; this port
		# raises that ceiling to MAX_ARENA_SCALE. Below the TS ceiling the two
		# must still agree exactly — that is what this fixture exists to prove.
		# At or above it, the divergence is asserted instead of parity.
		if expected_scale < TS_CEILING:
			assert_almost_eq(got, expected_scale, 0.0001, "arena_scale(%s, %s)" % [w, h])
		else:
			assert_gte(got, expected_scale, "the raised ceiling never shrinks a case")
			assert_lte(got, GameRoot.MAX_ARENA_SCALE, "still clamped, just higher")


func test_the_clamp_bounds_are_the_ported_ones() -> void:
	assert_almost_eq(
		GameRoot.arena_scale(1.0, 1.0),
		0.60,
		0.0001,
		"floor — web/src/tilt-to-live/TiltGame.ts:2431"
	)
	assert_almost_eq(
		GameRoot.arena_scale(9000.0, 9000.0),
		GameRoot.MAX_ARENA_SCALE,
		0.0001,
		"ceiling raised per M2.5 §7.3 — TiltGame.ts:2431's 1.15 letterboxed the phone"
	)


# DIVERGENCE(mobile-scale): no TypeScript counterpart. On a phone the raw
# formula (1.588 on a 1080 px short side) inflates weapon ranges, formation
# spacing and speeds until the playfield feels cramped; the ceiling below
# holds the "map" down while EntityLayer's model scale grows the models.
func test_effective_scale_is_the_raw_scale_on_desktop() -> void:
	assert_almost_eq(
		GameRoot.effective_arena_scale(1267.0, 717.0, false),
		GameRoot.arena_scale(1267.0, 717.0),
		0.0001,
		"desktop is untouched"
	)


func test_effective_scale_is_capped_on_mobile() -> void:
	assert_almost_eq(
		GameRoot.effective_arena_scale(1080.0, 2340.0, true),
		GameRoot.MOBILE_ARENA_SCALE_CEILING,
		0.0001,
		"the A55's 1.588 is clamped to the mobile ceiling"
	)
	assert_lt(GameRoot.MOBILE_ARENA_SCALE_CEILING, GameRoot.MAX_ARENA_SCALE)


func test_effective_scale_keeps_small_phones_below_the_mobile_ceiling() -> void:
	assert_almost_eq(
		GameRoot.effective_arena_scale(640.0, 1136.0, true),
		GameRoot.arena_scale(640.0, 1136.0),
		0.0001,
		"a value under the ceiling passes through untouched"
	)


func test_model_scale_only_grows_on_mobile() -> void:
	assert_almost_eq(GameRoot.model_scale_for(false), 1.0, 0.0001, "desktop draws at sim size")
	assert_almost_eq(GameRoot.model_scale_for(true), GameRoot.MOBILE_MODEL_SCALE, 0.0001)
	assert_gt(GameRoot.MOBILE_MODEL_SCALE, 1.0)
