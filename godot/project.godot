; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Peril Point"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
run/max_fps=60

[autoload]

Log="*res://src/core/log.gd"
GameEvents="*res://src/core/game_events.gd"

[debug]

gdscript/warnings/unused_variable=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

